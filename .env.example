# Copy to `.env` in this directory (`cp .env.example .env`) and edit. Docker Compose
# loads `.env` automatically when you run `docker compose` here.
#
# Variables below apply to the production UI stack: `docker-compose.yml` → service `evuproxy-ui`
# (see `docker/entrypoint.sh`). They are not used by `docker-compose.dev.yml`.

# -----------------------------------------------------------------------------
# Published UI image (optional)
# -----------------------------------------------------------------------------
# Leave unset to build the image from this checkout. To run a release instead, set
# the version that matches `evuproxy version` on this host, then run
# `docker compose pull && docker compose up -d --no-build`.
#
# EVUPROXY_UI_IMAGE=ghcr.io/imevul/evuproxy-ui:0.17.0

# -----------------------------------------------------------------------------
# Listen address for nginx (host network)
# -----------------------------------------------------------------------------
# With `network_mode: host`, this is where the UI binds on the **VPS host**.
#
# 127.0.0.1:9080 — default: only reachable from the host (e.g. SSH -L 9080:…).
# 0.0.0.0:9080   — use when a reverse proxy in another Docker network (or LAN)
#                  must reach the UI via the host/bridge IP. Lock down 9080 in
#                  the firewall; expose the UI through the proxy, not publicly.
#                  The compose healthcheck probes this URL too (for bind 0.0.0.0 it
#                  uses 127.0.0.1 and the same port).
#
EVUPROXY_UI_LISTEN=127.0.0.1:9080

# -----------------------------------------------------------------------------
# Upstream for /api/ (evuproxy HTTP API)
# -----------------------------------------------------------------------------
# Host:port of the real evuproxy admin API (systemd `evuproxy-api.service`).
# With host networking, 127.0.0.1:9847 is correct when the API listens locally.
EVUPROXY_API_UPSTREAM=127.0.0.1:9847

# -----------------------------------------------------------------------------
# Extra API origins the UI may call (Content-Security-Policy connect-src)
# -----------------------------------------------------------------------------
# Leave empty unless the UI's "API base URL" points at another origin; the browser
# blocks the calls otherwise. Space-separated exact origins, no wildcards.
#
# EVUPROXY_UI_CONNECT_SRC=https://api.example.com:9847
EVUPROXY_UI_CONNECT_SRC=
