# Docker nftables bouncer config for EvuProxy (set-only — rules come from evuproxy reload).
# Copied to docker-bouncer.yaml by install.sh. Placeholders are expanded at container start.
#
# Requires CROWDSEC_BOUNCER_KEY and CROWDSEC_LAPI_URL in the container environment (.env).

mode: nftables
update_frequency: 10s
daemonize: false
log_mode: stdout
log_dir: /var/log/

api_url: ${CROWDSEC_LAPI_URL}/
api_key: ${CROWDSEC_BOUNCER_KEY}
insecure_skip_verify: false

blacklists_ipv4: crowdsec_block_v4
disable_ipv6: true

supported_decisions_types:
  - ban

nftables:
  ipv4:
    enabled: true
    set-only: true
    table: evuproxy
  ipv6:
    enabled: false
