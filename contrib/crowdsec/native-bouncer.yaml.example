# Native nftables bouncer config for EvuProxy (set-only — rules come from evuproxy reload).
# Installed by install.sh to /etc/crowdsec/bouncers/crowdsec-firewall-bouncer.yaml
# when that file does not exist. See README.md.
#
# Replace __BOUNCER_KEY__ with the key from: cscli bouncers add evuproxy-nft-bouncer -o raw

mode: nftables
update_frequency: 10s
daemonize: true
log_mode: file
log_dir: /var/log/

api_url: http://127.0.0.1:8080/
api_key: __BOUNCER_KEY__
insecure_skip_verify: false

blacklists_ipv4: crowdsec_block_v4
disable_ipv6: true

supported_decisions_types:
  - ban

nftables:
  ipv4:
    enabled: true
    set-only: true
    table: evuproxy
  ipv6:
    enabled: false
