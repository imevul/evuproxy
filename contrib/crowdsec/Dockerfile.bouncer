# EvuProxy CrowdSec nftables bouncer — host network + NET_ADMIN updates inet evuproxy.
# Binary is downloaded on the host by install.sh (vendor/) so image build needs no network/DNS.

FROM debian:bookworm-slim

COPY vendor/crowdsec-firewall-bouncer-v0.0.34/crowdsec-firewall-bouncer /usr/local/bin/crowdsec-firewall-bouncer
COPY docker-bouncer-entrypoint.sh /entrypoint.sh
RUN chmod +x /usr/local/bin/crowdsec-firewall-bouncer /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
