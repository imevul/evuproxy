# Copy to .env beside docker-compose.example.yaml (do not commit .env).
# Usually created automatically by ./install.sh or make crowdsec-install.
#
# Manual key generation (CrowdSec must be running):
#   docker compose -f docker-compose.example.yaml exec crowdsec \
#     cscli bouncers add evuproxy-nft-bouncer -o raw

CROWDSEC_BOUNCER_KEY=
CROWDSEC_LAPI_URL=http://127.0.0.1:8080
